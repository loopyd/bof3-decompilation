{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "BOF3 PSX",
      "generator": "Unix Makefiles",
      "toolchainFile": "${sourceDir}/cmake/toolchains/psyq.cmake",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HARNESS_TARGET_PSX": "ON",
        "HARNESS_PROFILE": "compat/capcom97"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 0
    }
  ]
}
