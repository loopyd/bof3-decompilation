{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "default",
      "inherits": "bof3-psyq40"
    },
    {
      "name": "bof3-psyq40",
      "displayName": "bof3 capcom97 PsyQ 4.0 + maspsx 2.56",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/psyq.cmake",
      "binaryDir": "${sourceDir}/build/bof3-psyq40",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BOF3_TARGET_PSX": "ON",
        "BOF3_PSX_PROFILE": "capcom97-bof3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "bof3-psyq40",
      "configurePreset": "bof3-psyq40"
    }
  ]
}
