{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "BOF3 PSX",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/psyq.cmake",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BOF3_TARGET_PSX": "ON",
        "BOF3_PSX_PROFILE": "capcom97-bof3",
        "BOF3_PSYQ_VERSION": "4.7"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
