#!/usr/bin/env bash
set -euo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
  cat <<'USAGE'
Usage:
  psx-rizin inspect-exe <file> [--json]
  psx-rizin extract-exe <file> -o <payload>
  psx-rizin offset-to-addr <file> <offset>
  psx-rizin addr-to-offset <file> <address>
  psx-rizin aliases <address>
  psx-rizin scan <raw-binary> [--base <address>] [options]
  psx-rizin export <raw-binary> --base <address> --out <directory>
  psx-rizin function <raw-binary> <address> --base <address> --out <directory>
  psx-rizin symbols <csv-or-json> -o <script.rz>
  psx-rizin replay-coverage <matrix.csv> [--report <report.md>]
  psx-rizin lift <PS-X-EXE-or-raw-binary> [--base <address>]
  psx-rizin build-diff
USAGE
}

[[ $# -gt 0 ]] || { usage; exit 2; }
command_name="$1"
shift

case "$command_name" in
  inspect-exe) exec python3 "$ROOT/scripts/psx_exe.py" inspect "$@" ;;
  extract-exe) exec python3 "$ROOT/scripts/psx_exe.py" extract "$@" ;;
  offset-to-addr) exec python3 "$ROOT/scripts/psx_exe.py" offset-to-addr "$@" ;;
  addr-to-offset) exec python3 "$ROOT/scripts/psx_exe.py" addr-to-offset "$@" ;;
  aliases) exec python3 "$ROOT/scripts/psx_exe.py" aliases "$@" ;;
  scan) exec python3 "$ROOT/scripts/scan_mips.py" "$@" ;;
  export) exec python3 "$ROOT/scripts/rizin_export.py" "$@" ;;
  function) exec python3 "$ROOT/scripts/function_artifacts.py" "$@" ;;
  symbols) exec python3 "$ROOT/scripts/symbols_to_rizin.py" "$@" ;;
  replay-coverage) exec python3 "$ROOT/scripts/replay_coverage.py" "$@" ;;
  lift) exec "$ROOT/bin/lift" "$@" ;;
  build-diff) exec "$ROOT/bin/build-diff" "$@" ;;
  -h|--help|help) usage ;;
  *) echo "error: unknown command: $command_name" >&2; usage >&2; exit 2 ;;
esac
