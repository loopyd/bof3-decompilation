#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "${SCRIPT_DIR}/.." && pwd)"

exec "${SCRIPT_DIR}/_bof3" plan ghidra \
  --inventory "${INVENTORY:-${ROOT_DIR}/out/ghidra-bootstrap/inventory.json}" \
  --groups "${GROUPS:-${ROOT_DIR}/out/ghidra-bootstrap/groups.json}" \
  --output "${OUTPUT:-${ROOT_DIR}/out/ghidra-bootstrap/ghidra_import_manifest.json}" \
  "$@"
