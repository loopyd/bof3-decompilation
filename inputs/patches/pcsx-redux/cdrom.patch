+};
+
+class Feed {
+  public:
+    Feed(bool cdda, uint64_t media, uint64_t mutation, uint64_t stream,
+         uint32_t rate, uint32_t frames, uint32_t stereo);
+    ~Feed();
+    Feed(const Feed&) = delete;
