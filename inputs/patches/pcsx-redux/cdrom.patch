+namespace PCSX::History::CD {
+
+enum class Operation : uint32_t {
+    CpuRead = 1, CpuWrite, HandlerRead, HandlerWrite, Command,
+    Read, Play, Lid, LidSeek, Dma, DmaComplete, Decode,
+};
+
+bool idle();
