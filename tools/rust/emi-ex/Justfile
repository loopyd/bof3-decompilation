set shell := ["bash", "-euo", "pipefail", "-c"]
set script-interpreter := ["bash", "-euo", "pipefail"]
set tempdir := "/tmp"

crate := justfile_directory()
repo := crate + "/../../.."
manifest := crate + "/Cargo.toml"
target_dir := repo + "/build/tools/rust/emi-ex"
v1_default := repo + "/build/third_party/deprecated/emi-ex/emi-ex"

default:
    @just --list

build:
    cargo build --locked --release --manifest-path "{{ manifest }}" --target-dir "{{ target_dir }}"

test:
    cargo test --locked --manifest-path "{{ manifest }}" --target-dir "{{ target_dir }}"

check:
    cargo fmt --manifest-path "{{ manifest }}" --check
    cargo clippy --locked --manifest-path "{{ manifest }}" --all-targets -- -D warnings
    cargo test --locked --manifest-path "{{ manifest }}" --target-dir "{{ target_dir }}"

format:
    cargo fmt --manifest-path "{{ manifest }}"

# Cargo scopes cleanup to this crate's target directory.
clean:
    cargo clean --manifest-path "{{ manifest }}" --target-dir "{{ target_dir }}"

# Compare typed names, manifests, and payload bytes with v1.
[script]
equivalence archive v1=v1_default:
    test -x "{{ v1 }}" || { echo "v1 emi-ex not found: {{ v1 }}" >&2; exit 1; }
    archive="$(realpath "{{ archive }}")"
    test -f "$archive"
    cargo build --quiet --locked --release --manifest-path "{{ manifest }}" --target-dir "{{ target_dir }}"
    work="$(mktemp -d "${TMPDIR:-/tmp}/emi-ex-equivalence.XXXXXX")"
    case "$work" in "${TMPDIR:-/tmp}"/emi-ex-equivalence.*) ;; *) echo "unsafe work directory: $work" >&2; exit 1;; esac
    test -n "$work" && test "$work" != "{{ repo }}" && test "$work" != "{{ repo }}/out"
    trap 'rm -rf "$work"' EXIT
    "{{ v1 }}" extract -q -e -J -o "$work/v1" "$archive"
    "{{ target_dir }}/release/emi-ex" extract -q -e -J -o "$work/v2" "$archive"
    diff --no-dereference --recursive "$work/v1" "$work/v2"
    find "$work/v2" -type f -print0 | sort -z | xargs -0 sha256sum

# Compare every EMI archive below a directory with v1.
[script]
equivalence-all archives v1=v1_default:
    test -x "{{ v1 }}" || { echo "v1 emi-ex not found: {{ v1 }}" >&2; exit 1; }
    archives="$(realpath "{{ archives }}")"
    test -d "$archives"
    cargo build --quiet --locked --release --manifest-path "{{ manifest }}" --target-dir "{{ target_dir }}"
    count=0
    while IFS= read -r -d '' archive; do
        count=$((count + 1))
        work="$(mktemp -d "${TMPDIR:-/tmp}/emi-ex-equivalence.XXXXXX")"
        case "$work" in "${TMPDIR:-/tmp}"/emi-ex-equivalence.*) ;; *) echo "unsafe work directory: $work" >&2; exit 1;; esac
        test -n "$work" && test "$work" != "{{ repo }}" && test "$work" != "{{ repo }}/out"
        "{{ v1 }}" extract -q -e -J -o "$work/v1" "$archive"
        "{{ target_dir }}/release/emi-ex" extract -q -e -J -o "$work/v2" "$archive"
        diff --no-dereference --recursive "$work/v1" "$work/v2"
        rm -rf -- "$work"
    done < <(find "$archives" -type f -iname '*.emi' -print0 | sort -z)
    echo "byte-identical extraction for $count EMI archives"
