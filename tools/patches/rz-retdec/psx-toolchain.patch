+void mergeDeclaredObjects(
+		Config& config,
+		const Config& supplied,
+		const std::string& path,
+		int addressBits)
+{
+	std::vector<std::string> rejected;
+	std::vector<const Object*> accepted;
+	std::map<std::string, Address> names;
+	std::map<Address, std::string> addresses;
