+bool parseScalarLlvmType(const std::string& llvmIr, unsigned& width, unsigned& levels)
+{
+	std::string text = llvmIr;
+	text.erase(std::remove_if(text.begin(), text.end(), [](char c) {
+		return c == ' ' || c == '\t'; }), text.end());
