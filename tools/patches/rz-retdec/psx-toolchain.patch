@@ -90,7 +90,15 @@ bool ConstantsAnalysis::run()
 				continue;
 			}
 
-			checkForGlobalInInstruction(RDA, store, store->getValueOperand(), true);
+			// MIPS constructs addresses across register definitions (LUI plus
+			// ADDIU/ORI). Symbolizing an intermediate high half relocates the
