+	// to unsigned. Avoid unnecessary sign extension of narrow bit patterns.
+	if (!lhs || !rhs || lhs->getSize() != rhs->getSize()
+			|| lhs->isSigned() != rhs->isSigned()
+			|| (lhs->getSize() != 8 && lhs->getSize() != 16)) {
+		emitBinaryOpExpr(op, expr);
+		return;
+	}
