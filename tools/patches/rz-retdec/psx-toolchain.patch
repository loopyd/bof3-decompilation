+void CHLLWriter::emitBitPatternEquality(const std::string &op, ShPtr<BinaryOpExpr> expr) {
+	auto operandType = [](ShPtr<Expression> operand) {
+		if (auto deref = cast<DerefOpExpr>(operand)) {
