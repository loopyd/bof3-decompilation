+				<< rejected.size() << " invalid declaration(s); none applied" << std::endl;
+		for (const auto& item : rejected)
+		{
+			Log::error() << "  " << item << std::endl;
+		}
+		return;
+	}
+
+	for (const Object* object : accepted)
+	{
+		config.globals.insert(*object);
+	}
