root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = off

[*.md]
trim_trailing_whitespace = false

[*.{c,h}]
indent_style = space
indent_size = 4
tab_width = 4

[*.{asm,s}]
indent_style = tab
indent_size = 8
tab_width = 8

[*.py]
indent_style = space
indent_size = 4
tab_width = 4

[*.{cmake,yml,yaml,toml}]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
tab_width = 8
