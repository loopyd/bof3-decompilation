#!/bin/sh
# Shared environment for Python-backed repository commands.
# Its private function receives interpreter, missing-interpreter status, and hint;
# callers explicitly apply PSX_PYTHON where historically supported.
# Callers inherit PYTHON, a trusted project-only PYTHONPATH, and safe-path mode.
set -eu

python_env() {
    _ROOT="${ROOT:-$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)}"
    _PYTHON="$1"
    _EXIT="$2"
    _HINT="$3"
    if [ ! -x "$_PYTHON" ]; then
        printf 'missing project Python environment: %s\n' "$_PYTHON" >&2
        if [ -n "$_HINT" ]; then
            printf '%s\n' "$_HINT" >&2
        fi
        exit "$_EXIT"
    fi
    export PYTHON="$_PYTHON"
    PYTHONPATH="${_ROOT}/tools/python"
    export PYTHONPATH
    PYTHONSAFEPATH=1
    export PYTHONSAFEPATH
}
