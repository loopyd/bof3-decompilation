#!/usr/bin/env python3
"""Extract a disc image into the repository evidence tree."""

from __future__ import annotations

import argparse
from pathlib import Path
import subprocess
import sys


ROOT = Path(__file__).resolve().parent.parent
TOOLS_PYTHON = ROOT / "tools" / "python"
PROJECT_PYTHON = ROOT / ".venv" / "bin" / "python"


def use_project_python() -> None:
    if not PROJECT_PYTHON.is_file():
        raise SystemExit(f"missing project Python environment: {PROJECT_PYTHON}; run `just venv`")
    if Path(sys.executable).resolve() != PROJECT_PYTHON.resolve():
        import os

        environment = os.environ.copy()
        environment["PYTHONPATH"] = str(TOOLS_PYTHON)
        os.execve(
            str(PROJECT_PYTHON),
            [str(PROJECT_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
            environment,
        )
    sys.path.insert(0, str(TOOLS_PYTHON))


use_project_python()

from harness.disk.inputs import resolve_disc_input_path  # noqa: E402
from harness.io import repo_layout  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    layout = repo_layout(ROOT)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--input", type=Path)
    parser.add_argument("--output", type=Path, default=layout.extracted_dir)
    args = parser.parse_args(argv)

    input_path = args.input or resolve_disc_input_path(layout.disc_dir)
    if input_path is None:
        raise SystemExit(f"no BIN/CUE disc image found under {layout.disc_dir}")
    args.output.mkdir(parents=True, exist_ok=True)
    subprocess.run(
        [str(ROOT / "bin" / "bof3-disk"), "extract", "-i", str(input_path), "-o", str(args.output)],
        cwd=ROOT,
        check=True,
    )
    print(f"extracted {input_path} to {args.output}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
