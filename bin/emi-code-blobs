#!/usr/bin/env python3
"""List EMI entries across the extracted corpus using `emi-ex list --json`.

Filter modes (--filter):
  code    file_type == 0 (generic RAM payload; may contain code) [default]
  data    file_type != 0 (graphics/audio/data payloads)
  all     every entry

Per-archive JSON is cached under out/analysis/emi-code-blobs/ so re-runs do not
re-scan binaries that already have a fresh entry list. Use --no-cache to force
a re-scan, or --refresh to invalidate the whole cache.

Output: JSON array of {archive, index, ram_ptr, size, file_type, code_off, first4}.
Pass one or more archive paths, or use --all to scan out/extracted/BIN.
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
EMI_EX = ROOT / "bin" / "emi-ex"
EXTRACTED = ROOT / "out" / "extracted" / "BIN"
CACHE_DIR = ROOT / "out" / "analysis" / "emi-code-blobs"


def matches(entry: dict, mode: str) -> bool:
    if mode == "all":
        return True
    if mode == "code":
        return entry.get("file_type", -1) == 0
    if mode == "data":
        return entry.get("file_type", -1) != 0
    return False


def cache_path(archive: Path) -> Path:
    rel = os.path.relpath(archive, EXTRACTED)
    return CACHE_DIR / (rel + ".json")


def write_cache(cp: Path, entries: list) -> None:
    cp.parent.mkdir(parents=True, exist_ok=True)
    cp.write_text(json.dumps(entries))


def scan_archive(archive: Path) -> list[dict]:
    """Run emi-ex and return the raw entry list for one archive."""
    r = subprocess.run(
        [str(EMI_EX), "list", "--json", str(archive)],
        capture_output=True, text=True, timeout=60, cwd=str(ROOT),
    )
    if r.returncode != 0:
        print(f"emi-code-blobs: {archive}: {r.stderr.strip()}", file=sys.stderr)
        return []
    try:
        return json.loads(r.stdout)
    except json.JSONDecodeError:
        return []


def list_archive(archive: Path, mode: str, use_cache: bool) -> list[dict]:
    cp = cache_path(archive)
    if use_cache and cp.exists():
        try:
            entries = json.loads(cp.read_text())
        except json.JSONDecodeError:
            entries = scan_archive(archive)
            write_cache(cp, entries)
    else:
        entries = scan_archive(archive)
        write_cache(cp, entries)

    rel = os.path.relpath(archive, EXTRACTED)
    return [
        {
            "archive": rel,
            "index": e["index"],
            "ram_ptr": e["ram_ptr"],
            "size": e["size"],
            "file_type": e["file_type"],
            "code_off": e["code_off"],
            "first4": e["first4"],
        }
        for e in entries
        if matches(e, mode)
    ]


def main() -> int:
    ap = argparse.ArgumentParser(description="List EMI entries / code blobs")
    ap.add_argument("archives", nargs="*", help="EMI archive paths (default: all under out/extracted/BIN)")
    ap.add_argument("--all", action="store_true", help="Scan all extracted EMI archives")
    ap.add_argument("--filter", choices=["code", "data", "all"], default="code",
                    help="Entry filter by file_type (default: code = type 0)")
    ap.add_argument("--no-cache", action="store_true", help="Ignore and overwrite cache")
    ap.add_argument("--refresh", action="store_true", help="Drop the whole cache first")
    args = ap.parse_args()

    if args.refresh and CACHE_DIR.exists():
        for f in CACHE_DIR.rglob("*.json"):
            f.unlink()

    CACHE_DIR.mkdir(parents=True, exist_ok=True)

    archives = args.archives
    if not archives:
        archives = sorted(str(p) for p in EXTRACTED.rglob("*.EMI"))

    use_cache = not args.no_cache
    blobs = []
    for a in archives:
        blobs.extend(list_archive(Path(a), args.filter, use_cache))

    print(json.dumps(blobs, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
