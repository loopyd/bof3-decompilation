#!/bin/sh
set -eu

REBOF3_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REBOF3_PYTHON_ENTRY="${REBOF3_SCRIPT_DIR}/_python_entry"
REBOF3_ENTRY_MODULE="rebof3.commands.toolchain"
REBOF3_ENTRY_TOOLCHAIN="psyq"
REBOF3_ENTRY_ACTION="setup"

exec "${REBOF3_PYTHON_ENTRY}" "${REBOF3_ENTRY_MODULE}" "${REBOF3_ENTRY_TOOLCHAIN}" "${REBOF3_ENTRY_ACTION}" "$@"
