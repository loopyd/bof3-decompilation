#!/bin/sh
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
PYTHON="${PSX_PYTHON:-${ROOT}/.venv/bin/python}"
if [ ! -x "$PYTHON" ]; then
    printf 'missing project Python environment: %s\n' "$PYTHON" >&2
    printf 'run `just venv` from %s\n' "$ROOT" >&2
    exit 1
fi
PYTHONPATH="${ROOT}/tools/python${PYTHONPATH:+:${PYTHONPATH}}"
export PYTHONPATH
exec "$PYTHON" -m harness.commands.toolchain psyq import "$@"
