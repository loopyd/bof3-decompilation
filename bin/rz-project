#!/bin/sh
# Target-qualified Rizin project command.
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
. "$ROOT/bin/python-env"
python_env "${PSX_PYTHON:-$ROOT/.venv/bin/python}" 2 'run `just venv` first'
PATH="$ROOT/toolchains/rizin/bin:$PATH"
export PATH
exec "$PYTHON" -m harness.commands.rz_project "$@"
