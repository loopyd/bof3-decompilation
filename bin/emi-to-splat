#!/usr/bin/env python3
"""Generate splat configs for every code-bearing EMI entry.

An EMI code blob is a catalog entry with ``type == 0``. For each such entry
that lacks a promoted config this tool:

  1. Materializes the normalized image to ``out/binaries/emi/<slug>.bin``
     (the catalog ``payload_path`` is the already-extracted ``.bin``).
  2. Scans functions with rizin at the entry's ``load_address``.
  3. Renders a splat config mapping each function as a ``func_<vma>``
     subsegment, reusing the harness splat helpers.
  4. Writes the target manifest so ``bin/splat`` can run it.
  5. Runs ``bin/splat`` to emit the asm stubs.

Usage:
  bin/emi-to-splat                         # all code blobs without a config
  bin/emi-to-splat BATTLE/BATTLE 3         # one archive_id + slot
  bin/emi-to-splat --dry                   # print what would run, no writes
  bin/emi-to-splat --no-splat              # write configs, skip extraction
"""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOOLS = ROOT / "tools" / "python"
CATALOG = ROOT / "out" / "catalog" / "emi.json"
SPLAT = ROOT / "bin" / "splat"
VERDICT = ROOT / "out" / "analysis" / "emi-code-verdict.json"
CODE_TYPES = {0}


def _harness():
    sys.path.insert(0, str(TOOLS))
    from harness import binaries
    return binaries


def load_verdicts() -> dict[str, str]:
    if VERDICT.exists():
        return json.loads(VERDICT.read_text())
    return {}


def save_verdicts(verdicts: dict[str, str]) -> None:
    VERDICT.parent.mkdir(parents=True, exist_ok=True)
    VERDICT.write_text(json.dumps(verdicts, indent=2, sort_keys=True))


def select_targets(binaries, *, only: tuple[str, int] | None) -> list[dict]:
    catalog = json.loads(CATALOG.read_text())
    entries = catalog["entries"]
    if only is not None:
        archive_id, slot = only
        return [
            e for e in entries
            if e["archive_id"].upper() == archive_id.upper() and e["slot"] == slot
        ]
    verdicts = load_verdicts()
    targets = []
    for e in entries:
        if e["type"] not in CODE_TYPES:
            continue
        # The catalog already ruled these out as non-code.
        if e.get("code_status") == "rejected":
            continue
        slug = binaries.target_slug(e)
        # A prior run already proved this blob is data, not code.
        if verdicts.get(slug) == "data":
            continue
        cfg = ROOT / "config" / "splat" / "emi" / f"{slug}.yaml"
        if cfg.exists():
            continue
        targets.append(e)
    return targets


def process(binaries, entry: dict, verdicts: dict[str, str], *, dry: bool, run_splat: bool) -> int:
    slug = binaries.target_slug(entry)
    root = ROOT
    bin_path = root / "out" / "binaries" / "emi" / f"{slug}.bin"
    cfg_path = root / "config" / "splat" / "emi" / f"{slug}.yaml"
    manifest_path = root / "config" / "targets" / "emi" / f"{slug}.toml"
    source_dir = root / "src" / "emi" / slug

    if dry:
        print(f"[dry] {slug}: archive={entry['archive_id']} slot={entry['slot']} "
              f"load={entry['load_address_hex']} size={entry['size']}")
        return 0

    # Materialize normalized image from the extracted payload.
    payload = Path(entry["payload_path"]).read_bytes()
    bin_path.parent.mkdir(parents=True, exist_ok=True)
    bin_path.write_bytes(payload)

    funcs = binaries.scan_entry_functions(entry, root)
    cfg_text = binaries.splat_config_with_functions(
        entry, root, funcs, target_path=bin_path
    )
    cfg_path.parent.mkdir(parents=True, exist_ok=True)
    cfg_path.write_text(cfg_text, encoding="utf-8")

    manifest_text = binaries._render_manifest(
        entry, slug, f"emi/{slug}", "compat/capcom97"
    )
    manifest_path.parent.mkdir(parents=True, exist_ok=True)
    manifest_path.write_text(manifest_text, encoding="utf-8")

    source_dir.mkdir(parents=True, exist_ok=True)
    guard = binaries._short_header_guard(slug)
    header_path = source_dir / "internal.h"
    if not header_path.exists():
        header_path.write_text(
            f"#ifndef {guard}\n#define {guard}\n\n#endif\n", encoding="utf-8"
        )

    print(f"wrote {cfg_path.relative_to(root)} ({len(funcs)} functions)")
    if not run_splat:
        return 0

    r = binaries_run_splat(slug)
    if r != 0:
        print(f"  splat failed (rc={r})")
        return r

    # Self-validate: rizin found no functions, or every generated .s is
    # invalid, means this blob is data (not code). Drop the artifacts and
    # remember the verdict so a later run skips it without re-scanning.
    if not funcs or all_invalid(slug):
        remove_target(slug)
        verdicts[slug] = "data"
        reason = "no functions" if not funcs else "only data (0 code functions)"
        print(f"  dropped {slug}: rizin found {reason}")
    else:
        verdicts[slug] = "code"
    return 0


def binaries_run_splat(slug: str) -> int:
    import subprocess
    r = subprocess.run([str(SPLAT), f"emi/{slug}"],
                       capture_output=True, text=True, cwd=str(ROOT))
    if r.returncode == 0:
        print("  splat OK")
    return r.returncode


def all_invalid(slug: str) -> bool:
    asm = ROOT / "out" / "splat" / "emi" / slug / "asm"
    ss = list(asm.glob("*.s")) if asm.is_dir() else []
    if not ss:
        return True
    inv = sum(1 for s in ss if "invalid instruction" in s.read_text(errors="ignore"))
    return inv == len(ss)


def remove_target(slug: str) -> None:
    import shutil
    (ROOT / "config/splat/emi" / f"{slug}.yaml").unlink(missing_ok=True)
    (ROOT / "config/targets/emi" / f"{slug}.toml").unlink(missing_ok=True)
    shutil.rmtree(ROOT / "out/splat/emi" / slug, ignore_errors=True)
    shutil.rmtree(ROOT / "src/emi" / slug, ignore_errors=True)
    (ROOT / "out/binaries/emi" / f"{slug}.bin").unlink(missing_ok=True)


def main() -> int:
    ap = argparse.ArgumentParser(description="Generate splat configs for EMI code blobs")
    ap.add_argument("archive_id", nargs="?", help="EMI archive_id (e.g. BATTLE/BATTLE)")
    ap.add_argument("slot", nargs="?", type=int, help="entry slot")
    ap.add_argument("--dry", action="store_true", help="list targets, don't write/run")
    ap.add_argument("--no-splat", action="store_true", help="write configs, skip splat")
    args = ap.parse_args()

    binaries = _harness()
    only = None
    if args.archive_id or args.slot is not None:
        if not (args.archive_id and args.slot is not None):
            ap.error("provide both archive_id and slot, or neither for --all")
        only = (args.archive_id, args.slot)

    targets = select_targets(binaries, only=only)
    if not targets:
        print("no code blobs to process")
        return 0

    verdicts = load_verdicts()
    done = 0
    for entry in targets:
        rc = process(binaries, entry, verdicts, dry=args.dry, run_splat=not args.no_splat)
        if rc == 0:
            done += 1
    if not args.dry:
        save_verdicts(verdicts)
        print(f"done: {done}/{len(targets)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
