#!/bin/sh
# rebof3 — BOF3 workspace command surface
set -eu

REBOF3_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REBOF3_ROOT_DIR="$(CDPATH= cd -- "${REBOF3_SCRIPT_DIR}/.." && pwd)"
REBOF3_PYTHON_BIN="${REBOF3_ROOT_DIR}/.venv/bin/python"
REBOF3_PYTHONPATH_ROOT="${REBOF3_ROOT_DIR}/tools/python"

if [ ! -x "${REBOF3_PYTHON_BIN}" ]; then
  printf 'missing project Python environment: %s\n' "${REBOF3_PYTHON_BIN}" >&2
  printf 'run `just venv` from %s\n' "${REBOF3_ROOT_DIR}" >&2
  exit 1
fi

PYTHONPATH="${REBOF3_PYTHONPATH_ROOT}"
export PYTHONPATH

exec "${REBOF3_PYTHON_BIN}" -m rebof3.commands.rebof3 "$@"
