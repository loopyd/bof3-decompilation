#!/usr/bin/env python3
"""Show progress from the repository's existing EMI target-progress logic."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
TOOLS_PYTHON = ROOT / "tools" / "python"
PROJECT_PYTHON = ROOT / ".venv" / "bin" / "python"


def use_project_python() -> None:
    if not PROJECT_PYTHON.is_file():
        print(
            f"missing project Python environment: {PROJECT_PYTHON}\n"
            f"run `just venv` from {ROOT}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    if Path(sys.executable).resolve() != PROJECT_PYTHON.resolve():
        environment = os.environ.copy()
        environment["PYTHONPATH"] = str(TOOLS_PYTHON)
        os.execve(
            str(PROJECT_PYTHON),
            [str(PROJECT_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
            environment,
        )
    os.environ["PYTHONPATH"] = str(TOOLS_PYTHON)
    sys.path.insert(0, str(TOOLS_PYTHON))


use_project_python()

from harness.binaries import resolve_entry, target_progress  # noqa: E402
from harness.domain import load_target_manifests, normalize_target_id  # noqa: E402
from harness.io import read_json  # noqa: E402


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description="Show reviewed, lifted, matched, and payload progress."
    )
    parser.add_argument("target", nargs="?", help="target manifest ID")
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--json", action="store_true")
    return parser


def progress_for(root: Path, target_id: str, manifest, catalog: dict) -> dict:
    if manifest.kind != "emi":
        raise ValueError(
            f"progress data is currently available for EMI targets only: {target_id}"
        )
    entry = resolve_entry(catalog, manifest.disc_id)
    return {
        "target": target_id,
        "kind": manifest.kind,
        "status": manifest.status,
        "progress": target_progress(entry, root),
    }


def run(args: argparse.Namespace) -> int:
    root = args.root.resolve()
    manifests = load_target_manifests(root)
    if not manifests:
        raise ValueError(
            f"no target manifests found under {root / 'config' / 'targets'}"
        )

    selected = manifests
    if args.target is not None:
        target_id = normalize_target_id(args.target).value
        manifest = manifests.get(target_id)
        if manifest is None:
            raise ValueError(f"unknown target: {args.target}")
        selected = {target_id: manifest}

    catalog_path = root / "out" / "catalog" / "emi.json"
    if not catalog_path.is_file():
        raise FileNotFoundError(
            f"missing {catalog_path}; run `bin/harness discover` first"
        )
    catalog = read_json(catalog_path)
    rows = [
        progress_for(root, target_id, manifest, catalog)
        for target_id, manifest in sorted(selected.items())
        if manifest.kind == "emi"
    ]
    if args.target is not None and not rows:
        raise ValueError(f"target is not an EMI target: {args.target}")
    if args.json:
        print(json.dumps(rows[0] if args.target else rows, indent=2, sort_keys=True))
        return 0
    for row in rows:
        progress = row["progress"]
        next_function = progress["next_function"]
        next_text = "-" if next_function is None else f"0x{next_function:08x}"
        whole_payload = "yes" if progress["whole_payload_match"] else "no"
        print(
            f"{row['target']} layout={progress['layout']} "
            f"reviewed={progress['reviewed_functions']} "
            f"lifted={progress['lifted_functions']} "
            f"matched={progress['matched_functions']} "
            f"next={next_text} whole-payload={whole_payload}"
        )
    return 0


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return run(args)
    except (FileNotFoundError, RuntimeError, ValueError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
