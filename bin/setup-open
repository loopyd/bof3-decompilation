#!/bin/sh
set -eu

REBOF3_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REBOF3_PYTHON_ENTRY="${REBOF3_SCRIPT_DIR}/_python_entry"
REBOF3_ENTRY_MODULE="rebof3.commands.setup"
REBOF3_ENTRY_ARG_1="--open"
REBOF3_HELP_USAGE="usage: setup-open [--force]"
REBOF3_HELP_DESCRIPTION="Run the fresh-clone open setup path and stop before PsyQ, disc extraction, and unpack."

if [ "${1-}" = "-h" ] || [ "${1-}" = "--help" ]; then
  printf '%s\n' "${REBOF3_HELP_USAGE}"
  if [ -n "${REBOF3_HELP_DESCRIPTION:-}" ]; then
    printf '%s\n' ''
    printf '%s\n' "${REBOF3_HELP_DESCRIPTION}"
  fi
  exit 0
fi

exec "${REBOF3_PYTHON_ENTRY}" "${REBOF3_ENTRY_MODULE}" "${REBOF3_ENTRY_ARG_1}" "$@"
