#!/usr/bin/env python3
"""Build a transitional function-text-only BOF3 image."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import hashlib
import os
from pathlib import Path
import subprocess
import sys
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
TOOLS_PYTHON = ROOT / "tools" / "python"
PROJECT_PYTHON = ROOT / ".venv" / "bin" / "python"


def use_project_python() -> None:
    if not PROJECT_PYTHON.is_file():
        print(
            f"missing project Python environment: {PROJECT_PYTHON}\n"
            f"run `just venv` from {ROOT}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    if Path(sys.executable).resolve() != PROJECT_PYTHON.resolve():
        environment = os.environ.copy()
        environment["PYTHONPATH"] = str(TOOLS_PYTHON)
        os.execve(
            str(PROJECT_PYTHON),
            [str(PROJECT_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
            environment,
        )
    os.environ["PYTHONPATH"] = str(TOOLS_PYTHON)
    sys.path.insert(0, str(TOOLS_PYTHON))


if __name__ == "__main__":
    use_project_python()
else:
    if str(TOOLS_PYTHON) not in sys.path:
        sys.path.insert(0, str(TOOLS_PYTHON))

from harness.build.raw_module import extract_text  # noqa: E402
from harness.io import RepoLayout, repo_layout, write_json  # noqa: E402
from harness.match._asm_resolve import (  # noqa: E402
    object_path_for_source,
    parse_source_address,
)
from harness.targets import (  # noqa: E402
    load_target_manifests,
    normalize_target_id,
)


TRANSITIONAL_NOTE = (
    "unmatched regions are zero-filled; this is not a full source-only link"
)


@dataclass(frozen=True)
class FunctionSource:
    path: Path
    address: int


@dataclass
class BuildResult:
    target_id: str
    output_path: Path
    metadata_path: Path
    original_path: Path
    original_sha1: str
    original_length: int
    patched_functions: list[dict[str, Any]]
    skipped_functions: list[dict[str, str]]
    errors: list[dict[str, str]]
    rebuilt_sha1: str | None = None
    rebuilt_length: int | None = None
    wrote_output: bool = False


def _relative_path(layout: RepoLayout, path: Path) -> str:
    try:
        return path.resolve().relative_to(layout.root).as_posix()
    except ValueError:
        return str(path)


def resolve_manifest(root: Path, target: str):
    manifests = load_target_manifests(root)
    normalized = normalize_target_id(target).value
    manifest = manifests.get(normalized)
    if manifest is None:
        raise ValueError(f"unknown target: {target}")
    if manifest.status != "active":
        raise ValueError(f"target is not active: {normalized}")
    return manifest


def collect_function_sources(
    source_dir: Path,
) -> tuple[list[FunctionSource], list[dict[str, str]]]:
    functions: list[FunctionSource] = []
    skipped: list[dict[str, str]] = []
    for source_path in sorted(source_dir.glob("func_*.c")):
        try:
            address = parse_source_address(source_path)
        except (UnicodeError, ValueError) as exc:
            skipped.append({"source": str(source_path), "reason": str(exc)})
            continue
        functions.append(FunctionSource(source_path, address))
    functions.sort(key=lambda function: (function.address, function.path.name))
    return functions, skipped


def _output_path(layout: RepoLayout, target_id: str, output: Path | None) -> Path:
    if output is None:
        return layout.rebuilt_dir / f"{target_id}.bin"
    if output.is_absolute():
        return output.resolve()
    return (layout.root / output).resolve()


def _compile_object(layout: RepoLayout, source_path: Path, object_path: Path) -> None:
    if not (layout.root / "Makefile").is_file():
        raise FileNotFoundError(
            f"repository Makefile not found at {layout.root / 'Makefile'}"
        )
    target = object_path.resolve().relative_to(layout.root).as_posix()
    try:
        result = subprocess.run(
            ["make", "--no-print-directory", target],
            cwd=layout.root,
            capture_output=True,
            text=True,
            check=False,
        )
    except OSError as exc:
        raise RuntimeError(f"could not run make for {source_path}: {exc}") from exc
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        if detail:
            detail = f": {detail.splitlines()[-1]}"
        raise RuntimeError(f"object build failed for {source_path}{detail}")
    if not object_path.is_file():
        raise RuntimeError(f"make did not produce {object_path}")


def _metadata(
    layout: RepoLayout,
    result: BuildResult,
    manifest: Any,
    *,
    allow_nonmatching: bool,
) -> dict[str, Any]:
    payload: dict[str, Any] = {
        "schema": "harness.rebuilt-image/v1",
        "target": result.target_id,
        "kind": manifest.kind,
        "source_baseline": _relative_path(layout, result.original_path),
        "source_baseline_sha1": result.original_sha1,
        "source_baseline_length": result.original_length,
        "load_address": manifest.load_address,
        "patched_functions": result.patched_functions,
        "skipped_functions": result.skipped_functions,
        "errors": result.errors,
        "allow_nonmatching": allow_nonmatching,
        "data_rodata_patched": False,
        "unmatched_regions_remain_original": False,
        "unmatched_regions_zero_filled": True,
        "reconstruction_mode": "function-text-only-zero-fill",
        "output": _relative_path(layout, result.output_path),
    }
    if result.rebuilt_sha1 is not None:
        payload["rebuilt_sha1"] = result.rebuilt_sha1
    if result.rebuilt_length is not None:
        payload["rebuilt_length"] = result.rebuilt_length
    return payload


def build_target(
    layout: RepoLayout,
    manifest: Any,
    *,
    output: Path | None = None,
    no_build: bool = False,
    allow_nonmatching: bool = False,
) -> BuildResult:
    """Place compiled function text into a zero-filled manifest-sized image."""
    original_path = (layout.root / manifest.binary).resolve()
    if not original_path.is_file():
        raise FileNotFoundError(f"original target binary not found: {original_path}")
    output_path = _output_path(layout, manifest.id.value, output)
    if output_path == original_path:
        raise ValueError("rebuilt output must not overwrite the original target binary")
    source_dir = (layout.root / manifest.source_dir).resolve()
    if not source_dir.is_dir():
        raise FileNotFoundError(f"target source directory not found: {source_dir}")

    original = original_path.read_bytes()
    metadata_path = output_path.with_suffix(output_path.suffix + ".json")
    functions, skipped = collect_function_sources(source_dir)
    skipped = [
        {
            "source": _relative_path(layout, Path(item["source"])),
            "reason": item["reason"],
        }
        for item in skipped
    ]
    address_counts: dict[int, int] = {}
    for function in functions:
        address_counts[function.address] = address_counts.get(function.address, 0) + 1

    image = bytearray(len(original))
    patched: list[dict[str, Any]] = []
    errors: list[dict[str, str]] = []
    objcopy = layout.root / "bin" / "objcopy"

    for index, function in enumerate(functions):
        source_name = _relative_path(layout, function.path)
        if address_counts[function.address] > 1:
            errors.append(
                {
                    "source": source_name,
                    "reason": f"duplicate authored function address {function.address:#x}",
                }
            )
            continue

        try:
            object_path = object_path_for_source(layout, function.path)
            if no_build:
                if not object_path.is_file():
                    raise FileNotFoundError(f"object not found: {object_path}")
            else:
                _compile_object(layout, function.path, object_path)
            text = extract_text(objcopy, object_path)
            if not text:
                raise ValueError("compiled .text is empty")

            offset = function.address - manifest.load_address
            if offset < 0 or offset + len(text) > len(original):
                raise ValueError(
                    f"compiled .text at {function.address:#x}.."
                    f"{function.address + len(text):#x} is outside the original image"
                )
            next_address = (
                functions[index + 1].address if index + 1 < len(functions) else None
            )
            if next_address is not None and function.address + len(text) > next_address:
                raise ValueError(
                    f"compiled .text at {function.address:#x} overlaps next authored "
                    f"function boundary {next_address:#x}"
                )

            image[offset : offset + len(text)] = text
            patched.append(
                {
                    "source": source_name,
                    "address": f"0x{function.address:08x}",
                    "offset": offset,
                    "size": len(text),
                    "object": _relative_path(layout, object_path),
                }
            )
        except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as exc:
            errors.append({"source": source_name, "reason": str(exc)})

    result = BuildResult(
        target_id=manifest.id.value,
        output_path=output_path,
        metadata_path=metadata_path,
        original_path=original_path,
        original_sha1=hashlib.sha1(original).hexdigest(),
        original_length=len(original),
        patched_functions=patched,
        skipped_functions=skipped,
        errors=errors,
    )
    if (errors or skipped) and not allow_nonmatching:
        return result

    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_bytes(image)
    result.rebuilt_sha1 = hashlib.sha1(image).hexdigest()
    result.rebuilt_length = len(image)
    result.wrote_output = True
    write_json(
        metadata_path,
        _metadata(
            layout,
            result,
            manifest,
            allow_nonmatching=allow_nonmatching,
        ),
    )
    return result


def build_parser() -> argparse.ArgumentParser:
    return argparse.ArgumentParser(
        description=(
            "Build one target image by zero-filling the canonical target size "
            "and placing compiled authored function .text."
        ),
        epilog=(
            f"This is transitional reconstruction: {TRANSITIONAL_NOTE}. "
            "Data and rodata are not patched."
        ),
    )


def configure_parser(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("target", help="active target manifest ID, such as exe/logo")
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--output", type=Path, help="rebuilt image path")
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="use existing per-source objects instead of invoking make",
    )
    parser.add_argument(
        "--allow-nonmatching",
        action="store_true",
        help=(
            "write a partial image when a function is skipped or errors; "
            "this never makes bin/verify pass"
        ),
    )


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    configure_parser(parser)
    args = parser.parse_args(argv)
    root = args.root.resolve()
    try:
        manifest = resolve_manifest(root, args.target)
        result = build_target(
            repo_layout(root),
            manifest,
            output=args.output,
            no_build=args.no_build,
            allow_nonmatching=args.allow_nonmatching,
        )
    except (FileNotFoundError, OSError, ValueError) as exc:
        print(f"ERROR {args.target}: {exc}", file=sys.stderr)
        return 2

    output = str(result.output_path) if result.wrote_output else "<not written>"
    print(
        f"rebuilt {result.target_id}: patched={len(result.patched_functions)} "
        f"skipped={len(result.skipped_functions)} errors={len(result.errors)} "
        f"output={output}"
    )
    for item in result.skipped_functions:
        print(f"SKIP {item['source']}: {item['reason']}")
    for item in result.errors:
        print(f"ERROR {item['source']}: {item['reason']}")
    print(f"NOTE: {TRANSITIONAL_NOTE}; data/rodata are not patched.")
    if (result.errors or result.skipped_functions) and not args.allow_nonmatching:
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
