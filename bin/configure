#!/bin/sh
set -eu

REBOF3_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REBOF3_ROOT_DIR="$(CDPATH= cd -- "${REBOF3_SCRIPT_DIR}/.." && pwd)"
REBOF3_CMAKE_BIN="${CMAKE_BIN:-cmake}"
REBOF3_CMAKE_PRESET="${CMAKE_PRESET:-default}"
REBOF3_CMAKE_PRESET_FLAG="--preset"

cd -- "${REBOF3_ROOT_DIR}"
exec "${REBOF3_CMAKE_BIN}" "${REBOF3_CMAKE_PRESET_FLAG}" "${REBOF3_CMAKE_PRESET}" "$@"
