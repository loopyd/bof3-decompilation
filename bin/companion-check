#!/bin/sh
# Verify evidence required to lift through an EMI companion static call.
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
. "$ROOT/bin/python-env"
python_env "${PSX_PYTHON:-$ROOT/.venv/bin/python}" 2 'run `just venv` first'
exec "$PYTHON" -m harness.commands.companion_check "$@"
