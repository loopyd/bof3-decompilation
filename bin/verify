#!/usr/bin/env python3
"""Verify rebuilt BOF3 images against their canonical raw baselines."""

from __future__ import annotations

import argparse
from dataclasses import dataclass
import hashlib
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import sys
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
TOOLS_PYTHON = ROOT / "tools" / "python"
PROJECT_PYTHON = ROOT / ".venv" / "bin" / "python"


def use_project_python() -> None:
    if not PROJECT_PYTHON.is_file():
        print(
            f"missing project Python environment: {PROJECT_PYTHON}\n"
            f"run `just venv` from {ROOT}",
            file=sys.stderr,
        )
        raise SystemExit(1)
    if Path(sys.executable).resolve() != PROJECT_PYTHON.resolve():
        environment = os.environ.copy()
        environment["PYTHONPATH"] = str(TOOLS_PYTHON)
        os.execve(
            str(PROJECT_PYTHON),
            [str(PROJECT_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
            environment,
        )
    os.environ["PYTHONPATH"] = str(TOOLS_PYTHON)
    sys.path.insert(0, str(TOOLS_PYTHON))


if __name__ == "__main__":
    use_project_python()
else:
    if str(TOOLS_PYTHON) not in sys.path:
        sys.path.insert(0, str(TOOLS_PYTHON))

from harness.io import repo_layout  # noqa: E402
from harness.targets import load_target_manifests, normalize_target_id  # noqa: E402


def _load_rebuild_module() -> Any:
    module_name = "_bof3_rebuild_entrypoint"
    existing = sys.modules.get(module_name)
    if existing is not None:
        return existing
    path = Path(__file__).resolve().with_name("rebuild")
    loader = importlib.machinery.SourceFileLoader(module_name, str(path))
    spec = importlib.util.spec_from_loader(module_name, loader)
    if spec is None:
        raise RuntimeError(f"could not load rebuild entrypoint: {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[module_name] = module
    loader.exec_module(module)
    return module


@dataclass(frozen=True)
class VerificationResult:
    target_id: str
    status: str
    output_path: Path | None = None
    patched_count: int = 0
    error_count: int = 0
    byte_match: bool | None = None
    sha1_match: bool | None = None
    length_match: bool | None = None
    detail: str = ""

    @property
    def exact(self) -> bool:
        return self.status == "PASS"


def verify_target(
    root: Path,
    manifest: Any,
    *,
    output: Path | None = None,
    no_build: bool = False,
    allow_nonmatching: bool = False,
) -> VerificationResult:
    rebuild = _load_rebuild_module()
    try:
        result = rebuild.build_target(
            repo_layout(root),
            manifest,
            output=output,
            no_build=no_build,
            allow_nonmatching=allow_nonmatching,
        )
    except (FileNotFoundError, OSError, ValueError) as exc:
        return VerificationResult(manifest.id.value, "ERROR", detail=str(exc))

    if not result.wrote_output:
        return VerificationResult(
            result.target_id,
            "ERROR",
            output_path=result.output_path,
            patched_count=len(result.patched_functions),
            error_count=len(result.errors),
            detail=(
                "rebuild has incomplete function sources; use "
                "--allow-nonmatching to write it"
            ),
        )

    try:
        original = result.original_path.read_bytes()
        rebuilt = result.output_path.read_bytes()
    except OSError as exc:
        return VerificationResult(
            result.target_id,
            "ERROR",
            output_path=result.output_path,
            patched_count=len(result.patched_functions),
            error_count=len(result.errors),
            detail=str(exc),
        )

    length_match = len(original) == len(rebuilt)
    byte_match = original == rebuilt
    sha1_match = hashlib.sha1(original).digest() == hashlib.sha1(rebuilt).digest()
    exact = length_match and byte_match and sha1_match
    return VerificationResult(
        result.target_id,
        "PASS" if exact else "FAIL",
        output_path=result.output_path,
        patched_count=len(result.patched_functions),
        error_count=len(result.errors),
        byte_match=byte_match,
        sha1_match=sha1_match,
        length_match=length_match,
        detail="" if exact else "rebuilt image differs from the canonical baseline",
    )


def _selected_manifests(root: Path, target: str | None, all_targets: bool):
    manifests = load_target_manifests(root)
    if target is not None and all_targets:
        raise ValueError("target and --all are mutually exclusive")
    if target is not None:
        normalized = normalize_target_id(target).value
        manifest = manifests.get(normalized)
        if manifest is None:
            raise ValueError(f"unknown target: {target}")
        if manifest.status != "active":
            raise ValueError(f"target is not active: {normalized}")
        return [(normalized, manifest)]
    selected = [
        (target_id, manifest)
        for target_id, manifest in sorted(manifests.items())
        if manifest.status == "active"
    ]
    if not selected:
        raise ValueError(
            f"no active target manifests found under {root / 'config' / 'targets'}"
        )
    return selected


def _format_result(result: VerificationResult) -> str:
    if result.status == "ERROR":
        return f"ERROR {result.target_id}: {result.detail}"
    output = result.output_path if result.output_path is not None else "<none>"
    return (
        f"{result.status} {result.target_id} "
        f"bytes={'match' if result.byte_match else 'mismatch'} "
        f"sha1={'match' if result.sha1_match else 'mismatch'} "
        f"length={'match' if result.length_match else 'mismatch'} "
        f"patched={result.patched_count} errors={result.error_count} output={output}"
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        description=(
            "Rebuild and verify one active target, or every active target when "
            "no target is supplied."
        ),
        epilog=(
            "Verification compares exact bytes, SHA1, and length. "
            "The rebuild is transitional: unmatched regions are zero-filled "
            "and data/rodata are not patched."
        ),
    )
    parser.add_argument("target", nargs="?", help="active target manifest ID")
    parser.add_argument("--all", action="store_true", help="verify all active targets")
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--output", type=Path, help="rebuilt image path for one target")
    parser.add_argument(
        "--no-build",
        action="store_true",
        help="use existing per-source objects instead of invoking make",
    )
    parser.add_argument(
        "--allow-nonmatching",
        action="store_true",
        help=(
            "write a partial rebuild when a function errors; verification still "
            "returns nonzero unless the complete image is exact"
        ),
    )
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    root = args.root.resolve()
    try:
        manifests = _selected_manifests(root, args.target, args.all)
        if args.output is not None and len(manifests) != 1:
            raise ValueError("--output requires exactly one target")
    except ValueError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 2

    results = [
        verify_target(
            root,
            manifest,
            output=args.output,
            no_build=args.no_build,
            allow_nonmatching=args.allow_nonmatching,
        )
        for _target_id, manifest in manifests
    ]
    for result in results:
        print(_format_result(result))
    return 0 if all(result.exact for result in results) else 1


if __name__ == "__main__":
    raise SystemExit(main())
