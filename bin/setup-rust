#!/bin/sh
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
CARGO="${PSX_CARGO:-${CARGO:-cargo}}"

"$CARGO" build --locked --release \
    --manifest-path "${ROOT}/third_party/bof3-disk-v2/Cargo.toml" \
    --target-dir "${ROOT}/build/tools/rust/bof3-disk"
"$CARGO" build --locked --release \
    --manifest-path "${ROOT}/third_party/emi-ex-v2/Cargo.toml" \
    --target-dir "${ROOT}/build/tools/rust/emi-ex"
