#!/usr/bin/env python3
"""Normalize the executable images and refresh promoted EMI payloads."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parent.parent
TOOLS_PYTHON = ROOT / "tools" / "python"
PROJECT_PYTHON = ROOT / ".venv" / "bin" / "python"


def use_project_python() -> None:
    if not PROJECT_PYTHON.is_file():
        raise SystemExit(f"missing project Python environment: {PROJECT_PYTHON}; run `just venv`")
    if Path(sys.executable).resolve() != PROJECT_PYTHON.resolve():
        import os

        environment = os.environ.copy()
        environment["PYTHONPATH"] = str(TOOLS_PYTHON)
        os.execve(
            str(PROJECT_PYTHON),
            [str(PROJECT_PYTHON), str(Path(__file__).resolve()), *sys.argv[1:]],
            environment,
        )
    sys.path.insert(0, str(TOOLS_PYTHON))


use_project_python()

from harness.binaries import normalize_executable, verify_splat_hash  # noqa: E402
from harness.io import repo_layout  # noqa: E402
from harness.targets import (  # noqa: E402
    materialize_promoted_emi_targets,
    write_catalog,
)


def build_parser() -> argparse.ArgumentParser:
    layout = repo_layout(ROOT)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--slus", type=Path, default=layout.slus_path)
    parser.add_argument("--logo", type=Path, default=layout.logo_path)
    parser.add_argument("--root", type=Path, default=ROOT)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    root = args.root.resolve()
    layout = repo_layout(root)
    for name, source in (("slus_004_22", args.slus), ("logo", args.logo)):
        image = root / "out" / "binaries" / "exe" / f"{name}.bin"
        metadata = normalize_executable(source, image)
        verify_splat_hash(root / "config" / "splat" / "exe" / f"{name}.yaml", image)
        print(f"normalized {name}: {metadata['image']}")

    catalog_path = root / "out" / "catalog" / "emi.json"
    catalog = write_catalog(root / "out" / "extracted" / "BIN", catalog_path)
    for image in materialize_promoted_emi_targets(root=root, catalog=catalog):
        print(f"normalized EMI: {image}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
