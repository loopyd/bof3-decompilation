#!/bin/sh
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
BIN="${ROOT}/tools/c/psx-audio/build/bof3-audio"
EXTRACTED="${ROOT}/out/extracted"
BGM_DIR="${EXTRACTED}/BIN/BGM"
TMP_BASE="${ROOT}/out/audio/tmp"

build_if_needed() {
    if [ ! -x "$BIN" ]; then
        printf 'building psx-audio...\n' >&2
        cmake -S "${ROOT}/tools/c/psx-audio" -B "${ROOT}/tools/c/psx-audio/build" \
            -DCMAKE_BUILD_TYPE=Release >/dev/null 2>&1
        cmake --build "${ROOT}/tools/c/psx-audio/build" \
            -j"$(nproc 2>/dev/null || echo 4)" >/dev/null 2>&1
    fi
}

find_bgm_dir() {
    name="$1"
    upper="$(printf '%s' "$name" | tr '[:lower:]' '[:upper:]')"

    for candidate in \
        "${BGM_DIR}/${upper}" \
        "${BGM_DIR}/BGM${upper}" \
        "${BGM_DIR}/${upper}.EMI" \
        "${BGM_DIR}/BGM${upper}.EMI"; do
        if [ -e "$candidate" ]; then
            printf '%s' "$candidate"
            return 0
        fi
    done

    for d in "${BGM_DIR}"/*/; do
        base="$(basename "$d")"
        case "$(printf '%s' "$base" | tr '[:lower:]' '[:upper:]')" in
            *"$upper"*) printf '%s' "${d%/}"; return 0 ;;
        esac
    done

    return 1
}

resolve_emi() {
    path="$1"
    case "$path" in
        *.EMI|*.emi) printf '%s' "$path"; return 0 ;;
    esac
    emi="${path}.EMI"
    [ -f "$emi" ] && printf '%s' "$emi" && return 0
    emi="${path}/../$(basename "$path").EMI"
    [ -f "$emi" ] && printf '%s' "$emi" && return 0
    return 1
}

extract_and_find() {
    emi_path="$1"
    tmp_dir="$2"
    mkdir -p "$tmp_dir"
    "${ROOT}/bin/emi-ex" extract "$emi_path" "$tmp_dir" >/dev/null 2>&1

    vh="" vb="" sep=""
    for f in "$tmp_dir"/*.bin; do
        [ -f "$f" ] || continue
        magic="$(od -A n -t x1 -N 4 "$f" 2>/dev/null | tr -d ' ')"
        case "$magic" in
            70424156) vh="$f" ;;
            70514553) sep="$f" ;;
        esac
        size=$(wc -c < "$f" 2>/dev/null || echo 0)
        if [ -z "$vb" ] && [ "$size" -gt 10000 ] && [ "$magic" != "70424156" ] && [ "$magic" != "70514553" ]; then
            vb="$f"
        fi
    done

    if [ -z "$vh" ] || [ -z "$vb" ]; then
        printf 'error: could not find VAB header+body in %s\n' "$emi_path" >&2
        return 1
    fi
    printf '%s %s %s' "$vh" "$vb" "$sep"
}

cmd_list() {
    build_if_needed
    kind="${1:-all}"

    if [ "$kind" = "all" ] || [ "$kind" = "bgm" ]; then
        if [ -d "$BGM_DIR" ]; then
            count=0
            printf '\n  BGM Tracks\n'
            printf '  %s\n' "────────────────────────────────────────────────────"
            for d in "$BGM_DIR"/*/; do
                [ -d "$d" ] || continue
                name="$(basename "$d")"
                emi="${BGM_DIR}/${name}.EMI"
                [ -f "$emi" ] || continue
                vh="" sep=""
                for f in "$d"*.bin; do
                    [ -f "$f" ] || continue
                    magic="$(od -A n -t x1 -N 4 "$f" 2>/dev/null | tr -d ' ')"
                    case "$magic" in
                        70424156) vh="$f" ;;
                        70514553) sep="$f" ;;
                    esac
                done
                if [ -n "$vh" ] && [ -n "$sep" ]; then
                    info="$("$BIN" sep-inspect "$sep" 2>/dev/null | head -3 | tail -1)" || info=""
                    printf '  %-16s %s\n' "$name" "$info"
                    count=$((count + 1))
                fi
            done
            printf '  %d tracks\n\n' "$count"
        fi
    fi

    if [ "$kind" = "all" ] || [ "$kind" = "xa" ]; then
        printf '  XA Streaming Audio\n'
        printf '  %s\n' "────────────────────────────────────────────────────"
        for str in \
            "${EXTRACTED}/BIN/SCE_XA/S_XA00.STR" \
            "${EXTRACTED}/BIN/SCE_XA/VOICE.STR" \
            "${EXTRACTED}/BIN/BMAG_XA/MAGIC00.STR" \
            "${EXTRACTED}/LOGO/CAPCOM30.STR"; do
            [ -f "$str" ] || continue
            name="$(basename "$str")"
            "$BIN" xa-inspect "$str" 2>/dev/null | head -1
        done
        printf '\n'
    fi

    if [ "$kind" = "all" ] || [ "$kind" = "banks" ]; then
        printf '  Sound Banks (non-BGM VAB)\n'
        printf '  %s\n' "────────────────────────────────────────────────────"
        for fam in BATTLE BENEMY BMAGIC BOSS BPLCHAR PLCHAR ETC WORLD00 WORLD01 WORLD02 WORLD03 WORLD04; do
            dir="${EXTRACTED}/BIN/${fam}"
            [ -d "$dir" ] || continue
            count=0
            for emi in "$dir"/*.EMI; do
                [ -f "$emi" ] && count=$((count + 1))
            done
            [ "$count" -gt 0 ] && printf '  %-12s %d archives\n' "$fam" "$count"
        done
        printf '\n'
    fi
}

cmd_play() {
    build_if_needed
    target="$1"
    shift || true

    case "$target" in
        *.STR|*.str)
            exec "$BIN" play-xa "$target" "$@"
            ;;
    esac

    if [ -f "$target" ]; then
        case "$target" in
            *.EMI|*.emi)
                tmp="${TMP_BASE}/emi_$$"
                trap 'rm -rf "$tmp"' EXIT
                files="$(extract_and_find "$target" "$tmp")"
                set -- $files
                vh="$1" vb="$2" sep="$3"
                if [ -n "$sep" ]; then
                    exec "$BIN" play "$vh" "$vb" "$sep" "$@"
                else
                    exec "$BIN" play-vag "$vh" "$vb" "$@"
                fi
                ;;
        esac
        exec "$BIN" "$target" "$@"
    fi

    bgm_path="$(find_bgm_dir "$target")" || {
        printf 'error: track "%s" not found\n' "$target" >&2
        printf 'hint: bin/psx-audio list bgm\n' >&2
        exit 1
    }

    vh="" vb="" sep=""
    for f in "$bgm_path"/*.bin; do
        [ -f "$f" ] || continue
        magic="$(od -A n -t x1 -N 4 "$f" 2>/dev/null | tr -d ' ')"
        case "$magic" in
            70424156) vh="$f" ;;
            70514553) sep="$f" ;;
        esac
        size=$(wc -c < "$f" 2>/dev/null || echo 0)
        if [ -z "$vb" ] && [ "$size" -gt 10000 ] && [ "$magic" != "70424156" ] && [ "$magic" != "70514553" ]; then
            vb="$f"
        fi
    done

    if [ -z "$vh" ] || [ -z "$vb" ]; then
        emi="${bgm_path}.EMI"
        if [ -f "$emi" ]; then
            tmp="${TMP_BASE}/bgm_$$"
            trap 'rm -rf "$tmp"' EXIT
            files="$(extract_and_find "$emi" "$tmp")"
            set -- $files
            vh="$1" vb="$2" sep="$3"
        fi
    fi

    if [ -z "$vh" ] || [ -z "$vb" ]; then
        printf 'error: no VAB data found for %s\n' "$target" >&2
        exit 1
    fi

    if [ -n "$sep" ]; then
        exec "$BIN" play "$vh" "$vb" "$sep" "$@"
    else
        exec "$BIN" play-vag "$vh" "$vb" "$@"
    fi
}

usage() {
    cat <<'EOF'
Usage: bin/psx-audio <command> [args]

  list [bgm|xa|banks]              browse available audio
  play <track|file> [opts]         play audio (auto-detects format)
  play <vh> <vb> <sep> [opts]      play BGM from raw files

  play <track>                     play BGM by name (e.g. BGM000, BGMBAT06)
  play <file.EMI>                  extract EMI and play
  play <file.STR> [-c CH]          play XA stream
  play <vh> <vb> <sep>             play from raw extracted files

Options:
  -s SEQ      sequence index (default: 0)
  -g GAIN     playback gain (default: 1.0)
  -c CHANNEL  XA channel (default: 0)
  -v VAG      VAG index for play-vag

Raw commands (passed to C binary):
  render, xa-decode, xa-inspect, vab-extract, vab-inspect,
  sep-inspect, sep2mid, play-xa, play-vag

Examples:
  bin/psx-audio list
  bin/psx-audio play BGM000
  bin/psx-audio play BGMBAT06 -g 0.5
  bin/psx-audio play out/extracted/BIN/SCE_XA/VOICE.STR -c 0
  bin/psx-audio play out/extracted/BIN/BGM/BGMOPN.EMI
EOF
}

case "${1:-}" in
    ""|-h|--help|help) usage; exit 0 ;;
    list) shift; cmd_list "$@" ;;
    play) shift; cmd_play "$@" ;;
    *)
        build_if_needed
        exec "$BIN" "$@"
        ;;
esac
