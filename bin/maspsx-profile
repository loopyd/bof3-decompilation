#!/usr/bin/env python3
"""Read a maspsx-cc profile TOML and print POSIX shell variable assignments."""

import sys
from pathlib import Path
from os import path as osp

import toml


def usage():
    print("Usage: maspsx-profile [--root DIR] PROFILE_PATH", file=sys.stderr)
    print("  PROFILE_PATH  path to a .toml profile (e.g. config/compiler/c97.toml)", file=sys.stderr)
    sys.exit(2)


def shell_escape(s):
    """Single-quote a value for safe shell injection."""
    return "'" + s.replace("'", "'\\''") + "'"


def resolve(root, p):
    """Resolve a path: absolute paths pass through; others are relative to root."""
    if osp.isabs(p):
        return p
    return str(Path(root) / p)


def to_bool(value):
    """Interpret a toml bool as "1" or "0" for shell."""
    return "1" if value else "0"


def emit(name, value):
    """Print a POSIX shell variable assignment."""
    sys.stdout.write(f"{name}={shell_escape(str(value))}\n")


def toml_to_shell(root, profile):
    """Convert a parsed TOML profile dict to shell variable assignments."""
    cc = profile.get("cc", {})
    cc_flags = sh_join_flags(cc.get("flags", []))
    emit("CC_PATH", resolve(root, cc.get("path", "")))
    emit("CC_PROFILE_FLAGS", cc_flags)

    psyq = profile.get("psyq", {})
    emit("PSYQ_VERSION", psyq.get("version", ""))

    maspsx = profile.get("maspsx", {})
    emit("ASPSX_VERSION", maspsx.get("aspsx_version", ""))
    emit("MASPSX_SCRIPT", resolve(root, maspsx.get("script", "")))

    as_cfg = profile.get("as", {})
    as_flags = sh_join_flags(as_cfg.get("flags", []))
    emit("AS_TOOLCHAIN_BIN", resolve(root, as_cfg.get("toolchain_bin", "")))
    emit("AS_NAME", as_cfg.get("name", ""))
    emit("AS_FLAGS", as_flags)


def sh_join_flags(lst):
    """Join a list of flags into a single space-separated string."""
    return " ".join(str(f) for f in lst)


def main():
    root = None
    args = list(sys.argv[1:])
    while args:
        arg = args.pop(0)
        if arg == "--root":
            if not args:
                usage()
            root = args.pop(0)
        elif arg.startswith("--root="):
            root = arg.split("=", 1)[1]
        elif arg.startswith("-") and arg != "-":
            usage()
        else:
            profile_path = arg
            break
    else:
        usage()

    if root is None:
        # default: script is in bin/, root is parent
        root = str(Path(__file__).resolve().parent.parent)

    data = toml.load(profile_path)
    toml_to_shell(root, data)


if __name__ == "__main__":
    main()
