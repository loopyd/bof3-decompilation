#!/bin/sh
set -eu

ROOT="$(CDPATH='' cd -- "$(dirname "$0")/.." && pwd)"
WIBO_PATH="${PSX_WIBO_PATH:-${WIBO_PATH:-${ROOT}/toolchains/wibo/wibo}}"
WIBO_URL="${PSX_WIBO_URL:-${WIBO_URL:-https://github.com/decompals/wibo/releases/download/1.2.0/wibo-x86_64}}"
download=0
force=0

usage() {
    printf '%s\n' "usage: setup-wibo [--download] [--force]"
    printf '%s\n' '       setup-wibo --help'
    printf '%s\n' ''
    printf '%s\n' 'Check the local wibo path; use --download to fetch it.'
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --download)
            download=1
            ;;
        --force)
            force=1
            download=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            printf 'unknown option: %s\n' "$1" >&2
            usage >&2
            exit 2
            ;;
    esac
    shift
done

if [ -e "$WIBO_PATH" ] && [ ! -f "$WIBO_PATH" ]; then
    printf 'wibo path is not a regular file: %s\n' "$WIBO_PATH" >&2
    exit 1
fi

if [ -e "$WIBO_PATH" ] && [ "$force" -eq 0 ]; then
    if [ ! -x "$WIBO_PATH" ]; then
        if [ "$download" -eq 0 ]; then
            printf 'wibo exists but is not executable: %s\n' "$WIBO_PATH" >&2
            exit 1
        fi
        chmod +x "$WIBO_PATH"
    fi
    printf 'wibo: %s\n' "$WIBO_PATH"
    exit 0
fi

if [ "$download" -eq 0 ]; then
    printf 'wibo is not installed at %s; rerun with --download\n' "$WIBO_PATH" >&2
    exit 1
fi

downloader=''
if command -v curl >/dev/null 2>&1; then
    downloader=curl
elif command -v wget >/dev/null 2>&1; then
    downloader=wget
else
    printf 'cannot download wibo: neither curl nor wget is available\n' >&2
    exit 1
fi

mkdir -p "$(dirname "$WIBO_PATH")"
temporary="${WIBO_PATH}.tmp.$$"
trap 'rm -f -- "$temporary"' 0 1 2 3 15
if [ "$downloader" = curl ]; then
    curl -fL --silent --show-error --output "$temporary" "$WIBO_URL"
else
    wget -O "$temporary" "$WIBO_URL"
fi
if [ ! -s "$temporary" ]; then
    printf 'downloaded empty wibo file from %s\n' "$WIBO_URL" >&2
    exit 1
fi
chmod +x "$temporary"
mv -f "$temporary" "$WIBO_PATH"
trap - 0 1 2 3 15
printf 'wibo: %s\n' "$WIBO_PATH"
