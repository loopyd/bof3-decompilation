#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
MASPSX="${ROOT_DIR}/third_party/maspsx/maspsx.py"
LOCAL_COMPILER_ROOT="${ROOT_DIR}/toolchains/gcc-2.7.2-psx"
LOCAL_TOOLCHAIN_BIN="${ROOT_DIR}/toolchains/psn00b_toolchain/bin"
LOCAL_PSYQ_ROOT="${ROOT_DIR}/toolchains/psyq-original/4.0"
DEFAULT_PROFILE="capcom97-bof3"

resolve_toolchain_tool() {
	local local_name="$1"
	shift
	if [[ -x "${LOCAL_TOOLCHAIN_BIN}/${local_name}" ]]; then
		printf '%s\n' "${LOCAL_TOOLCHAIN_BIN}/${local_name}"
		return 0
	fi

	local candidate
	for candidate in "$@"; do
		if command -v "$candidate" >/dev/null 2>&1; then
			command -v "$candidate"
			return 0
		fi
	done

	echo "missing toolchain binary: ${local_name} (looked for $*)" >&2
	exit 1
}

resolve_c_compiler() {
	if [[ -n "${BOF3_PSX_GCC:-}" ]]; then
		if [[ -x "${BOF3_PSX_GCC}" ]]; then
			printf '%s\n' "${BOF3_PSX_GCC}"
			return 0
		fi
		echo "missing BOF3_PSX_GCC executable: ${BOF3_PSX_GCC}" >&2
		exit 1
	fi

	local compiler_root="${BOF3_PSX_GCC_ROOT:-${LOCAL_COMPILER_ROOT}}"
	if [[ -x "${compiler_root}/gcc" ]]; then
		printf '%s\n' "${compiler_root}/gcc"
		return 0
	fi

	echo "missing canonical PSX C compiler: ${compiler_root}/gcc" >&2
	echo "stage toolchains/gcc-2.7.2-psx or set BOF3_PSX_GCC / BOF3_PSX_GCC_ROOT" >&2
	exit 1
}

resolve_profile_settings() {
	case "$1" in
		capcom97-bof3)
			PSYQ_ROOT="${LOCAL_PSYQ_ROOT}"
			ASPSX_VERSION="2.56"
			;;
		*)
			echo "unsupported BOF3 PSX profile: $1" >&2
			exit 1
			;;
	esac
	PSYQ_INCLUDE="${PSYQ_ROOT}/include"
}

GCC="$(resolve_c_compiler)"
GCC_DIR="$(cd "$(dirname "${GCC}")" && pwd)"
AS="$(resolve_toolchain_tool mipsel-none-elf-as mipsel-linux-gnu-as mipsel-none-elf-as)"
PROFILE="${BOF3_PSX_PROFILE:-${DEFAULT_PROFILE}}"
resolve_profile_settings "${PROFILE}"

EXTRA_INCLUDE_FLAGS=()
PROFILE_FLAGS=(-O2 -G0 -funsigned-char -msoft-float -gcoff)
SOURCE=""
OUTPUT=""
EXTRA_FLAGS=()
MODE="compile"
PREPROCESS_FLAGS=()

while [[ $# -gt 0 ]]; do
	case $1 in
		--profile)
			PROFILE="$2"
			shift 2
			resolve_profile_settings "${PROFILE}"
			;;
		--profile=*)
			PROFILE="${1#--profile=}"
			shift
			resolve_profile_settings "${PROFILE}"
			;;
		-Wa,--aspsx-version=*)
			ASPSX_VERSION="${1#-Wa,--aspsx-version=}"
			shift
			;;
		-o)
			OUTPUT="$2"
			shift 2
			;;
		-c)
			SOURCE="$2"
			shift 2
			;;
		-E)
			MODE="preprocess"
			PREPROCESS_FLAGS+=("$1")
			shift
			;;
		-P|-dD)
			PREPROCESS_FLAGS+=("$1")
			shift
			;;
		*)
			EXTRA_FLAGS+=("$1")
			shift
			;;
	esac
done

if [[ -z "$SOURCE" ]] || [[ -z "$OUTPUT" ]]; then
	echo "Usage: $0 [--profile PROFILE] -c source.c -o output.o [flags...]" >&2
	exit 1
fi

if [[ ! -d "${PSYQ_INCLUDE}" ]]; then
	echo "missing PsyQ include root for profile ${PROFILE}: ${PSYQ_INCLUDE}" >&2
	exit 1
fi

export PATH="${GCC_DIR}:${LOCAL_TOOLCHAIN_BIN}${PATH:+:${PATH}}"
export GCC_EXEC_PREFIX="${GCC_DIR}/"
export COMPILER_PATH="${GCC_DIR}"

EXTRA_INCLUDE_FLAGS+=("-I${PSYQ_INCLUDE}")

if [[ "${MODE}" == "preprocess" ]]; then
	${GCC} "${EXTRA_INCLUDE_FLAGS[@]}" "${PROFILE_FLAGS[@]}" "${EXTRA_FLAGS[@]}" \
		"${PREPROCESS_FLAGS[@]}" -o "${OUTPUT}" "${SOURCE}"
	exit 0
fi

ASM_FILE="${OUTPUT}.s"

${GCC} "${EXTRA_INCLUDE_FLAGS[@]}" "${PROFILE_FLAGS[@]}" "${EXTRA_FLAGS[@]}" -S -o "${ASM_FILE}" "${SOURCE}"

python3 "${MASPSX}" --aspsx-version="${ASPSX_VERSION}" "${ASM_FILE}" | \
	${AS} -G0 -EL -mips1 -o "${OUTPUT}" -
