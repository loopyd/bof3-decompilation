#!/bin/bash
set -euo pipefail

REBOF3_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REBOF3_ROOT_DIR="$(cd "${REBOF3_SCRIPT_DIR}/.." && pwd)"
REBOF3_PYTHON_BIN="${PYTHON_BIN:-python3}"
REBOF3_MASPSX_SCRIPT="${REBOF3_ROOT_DIR}/third_party/maspsx/maspsx.py"
REBOF3_COMPILER_ROOT="${REBOF3_ROOT_DIR}/toolchains/gcc-2.7.2-psx"
REBOF3_TOOLCHAIN_BIN="${REBOF3_ROOT_DIR}/toolchains/psn00b_toolchain/bin"
REBOF3_PSYQ_ROOT="${REBOF3_ROOT_DIR}/toolchains/psyq-original/4.0"
REBOF3_DEFAULT_PROFILE="capcom97-bof3"
REBOF3_CAPCOM97_PROFILE="capcom97-bof3"
REBOF3_CAPCOM97_ASPSX_VERSION="2.56"
REBOF3_AS_LOCAL_NAME="mipsel-none-elf-as"
REBOF3_AS_CANDIDATES=(mipsel-linux-gnu-as mipsel-none-elf-as)
REBOF3_PROFILE_FLAGS=(-O2 -G0 -funsigned-char -msoft-float -gcoff)
REBOF3_ASSEMBLER_FLAGS=(-G0 -EL -mips1)
REBOF3_MODE_COMPILE="compile"
REBOF3_MODE_PREPROCESS="preprocess"
REBOF3_USAGE="Usage: $0 [--profile PROFILE] -c source.c -o output.o [flags...]"

resolve_toolchain_tool() {
	local local_name="$1"
	shift
	if [[ -x "${REBOF3_TOOLCHAIN_BIN}/${local_name}" ]]; then
		printf '%s\n' "${REBOF3_TOOLCHAIN_BIN}/${local_name}"
		return 0
	fi

	local candidate
	for candidate in "$@"; do
		if command -v "$candidate" >/dev/null 2>&1; then
			command -v "$candidate"
			return 0
		fi
	done

	echo "missing toolchain binary: ${local_name} (looked for $*)" >&2
	exit 1
}

resolve_c_compiler() {
	if [[ -n "${BOF3_PSX_GCC:-}" ]]; then
		if [[ -x "${BOF3_PSX_GCC}" ]]; then
			printf '%s\n' "${BOF3_PSX_GCC}"
			return 0
		fi
		echo "missing BOF3_PSX_GCC executable: ${BOF3_PSX_GCC}" >&2
		exit 1
	fi

	local compiler_root="${BOF3_PSX_GCC_ROOT:-${REBOF3_COMPILER_ROOT}}"
	if [[ -x "${compiler_root}/gcc" ]]; then
		printf '%s\n' "${compiler_root}/gcc"
		return 0
	fi

	echo "missing canonical PSX C compiler: ${compiler_root}/gcc" >&2
	echo "stage toolchains/gcc-2.7.2-psx or set BOF3_PSX_GCC / BOF3_PSX_GCC_ROOT" >&2
	exit 1
}

resolve_profile_settings() {
	case "$1" in
		"${REBOF3_CAPCOM97_PROFILE}")
			PSYQ_ROOT="${REBOF3_PSYQ_ROOT}"
			ASPSX_VERSION="${REBOF3_CAPCOM97_ASPSX_VERSION}"
			;;
		*)
			echo "unsupported BOF3 PSX profile: $1" >&2
			exit 1
			;;
	esac
	PSYQ_INCLUDE="${PSYQ_ROOT}/include"
}

GCC="$(resolve_c_compiler)"
GCC_DIR="$(cd "$(dirname "${GCC}")" && pwd)"
AS="$(resolve_toolchain_tool "${REBOF3_AS_LOCAL_NAME}" "${REBOF3_AS_CANDIDATES[@]}")"
PROFILE="${BOF3_PSX_PROFILE:-${REBOF3_DEFAULT_PROFILE}}"
ASPSX_VERSION="${REBOF3_CAPCOM97_ASPSX_VERSION}"
MODE="${REBOF3_MODE_COMPILE}"
SOURCE=""
OUTPUT=""
EXTRA_INCLUDE_FLAGS=()
EXTRA_FLAGS=()
PREPROCESS_FLAGS=()
resolve_profile_settings "${PROFILE}"

while [[ $# -gt 0 ]]; do
	case $1 in
		--profile)
			PROFILE="$2"
			shift 2
			resolve_profile_settings "${PROFILE}"
			;;
		--profile=*)
			PROFILE="${1#--profile=}"
			shift
			resolve_profile_settings "${PROFILE}"
			;;
		-Wa,--aspsx-version=*)
			ASPSX_VERSION="${1#-Wa,--aspsx-version=}"
			shift
			;;
		-o)
			OUTPUT="$2"
			shift 2
			;;
		-c)
			SOURCE="$2"
			shift 2
			;;
		-E)
			MODE="${REBOF3_MODE_PREPROCESS}"
			PREPROCESS_FLAGS+=("$1")
			shift
			;;
		-P|-dD)
			PREPROCESS_FLAGS+=("$1")
			shift
			;;
		*)
			EXTRA_FLAGS+=("$1")
			shift
			;;
	esac
done

if [[ -z "${SOURCE}" ]] || [[ -z "${OUTPUT}" ]]; then
	echo "${REBOF3_USAGE}" >&2
	exit 1
fi

if [[ ! -d "${PSYQ_INCLUDE}" ]]; then
	echo "missing PsyQ include root for profile ${PROFILE}: ${PSYQ_INCLUDE}" >&2
	exit 1
fi

export PATH="${GCC_DIR}:${REBOF3_TOOLCHAIN_BIN}${PATH:+:${PATH}}"
export GCC_EXEC_PREFIX="${GCC_DIR}/"
export COMPILER_PATH="${GCC_DIR}"

EXTRA_INCLUDE_FLAGS+=("-I${PSYQ_INCLUDE}")

if [[ "${MODE}" == "${REBOF3_MODE_PREPROCESS}" ]]; then
	"${GCC}" "${EXTRA_INCLUDE_FLAGS[@]}" "${REBOF3_PROFILE_FLAGS[@]}" "${EXTRA_FLAGS[@]}" \
		"${PREPROCESS_FLAGS[@]}" -o "${OUTPUT}" "${SOURCE}"
	exit 0
fi

ASM_FILE="${OUTPUT}.s"

	"${GCC}" "${EXTRA_INCLUDE_FLAGS[@]}" "${REBOF3_PROFILE_FLAGS[@]}" "${EXTRA_FLAGS[@]}" -S -o "${ASM_FILE}" "${SOURCE}"

	"${REBOF3_PYTHON_BIN}" "${REBOF3_MASPSX_SCRIPT}" --aspsx-version="${ASPSX_VERSION}" "${ASM_FILE}" | \
	"${AS}" "${REBOF3_ASSEMBLER_FLAGS[@]}" -o "${OUTPUT}" -
