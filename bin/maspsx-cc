#!/bin/sh
# maspsx-cc — PSX C compiler wrapper (GCC 2.7.2 → maspsx ASPSX translator → GNU as)
#
# Usage: maspsx-cc [--profile NAME|PATH] [--psyq-root PATH] [--psyq-version V]
#                  [-Wa,--aspsx-version=V] [-c] [-E] [-P] [-dD] [-I DIR] [-D DEF]
#                  [-o OUTPUT] [gcc-flags...] source.{c,s,S}
#
# Profiles are TOML files under config/compiler/ (looked up relative to the
# repository root). The default is 'capcom97-bof3'.
#
# Extra unknown flags are passed transparently to GCC after the profile flags
# so that the "last flag wins" rule lets you override e.g. -O2 with -O1.
#
# POSIX sh. Requires maspsx-profile (Python + toml) for profile loading.

set -euf

# --- locate ourselves ---

MASPSX_SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REBOF3_ROOT_DIR="$(cd "$MASPSX_SCRIPT_DIR/.." && pwd)"
MASPSX_LIB="${MASPSX_SCRIPT_DIR}/maspsx-lib"
MASPSX_PROFILE_BIN="${MASPSX_SCRIPT_DIR}/maspsx-profile"
MASPSX_USAGE="Usage: $0 [--profile NAME|PATH] [--psyq-root PATH] [--psyq-version V] [-Wa,--aspsx-version=V] [-c] [-E] source.{c,s,S} -o output.o [flags...]"

. "$MASPSX_LIB"

# --- default profile ---

MASPSX_DEFAULT_PROFILE="${REBOF3_ROOT_DIR}/config/compiler/capcom97-bof3.toml"

# --- parse CLI ---

PROFILE="${MASPSX_DEFAULT_PROFILE}"
PSYQ_ROOT=""
ASPSX_VERSION=""
MODE="compile"
_COMPILE_REQUESTED=0
SOURCE=""
OUTPUT=""
EXTRA_FLAGS=""
EXTRA_INC_FLAGS=""
PREPROCESS_FLAGS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --profile)
            arg_required "$1" "${2-}"
            PROFILE="$2"
            shift 2
            ;;
        --profile=*)
            PROFILE="$(option_value "$1" "--profile=")"
            shift
            ;;
        --psyq-root)
            arg_required "$1" "${2-}"
            PSYQ_ROOT="$2"
            shift 2
            ;;
        --psyq-root=*)
            PSYQ_ROOT="$(option_value "$1" "--psyq-root=")"
            shift
            ;;
        --psyq-version)
            arg_required "$1" "${2-}"
            PSYQ_ROOT="${REBOF3_ROOT_DIR}/toolchains/psyq/$2"
            shift 2
            ;;
        --psyq-version=*)
            PSYQ_ROOT="${REBOF3_ROOT_DIR}/toolchains/psyq/$(option_value "$1" "--psyq-version=")"
            shift
            ;;
        -Wa,--aspsx-version=*)
            ASPSX_VERSION="$(option_value "$1" "-Wa,--aspsx-version=")"
            shift
            ;;
        --aspsx-version)
            arg_required "$1" "${2-}"
            ASPSX_VERSION="$2"
            shift 2
            ;;
        --aspsx-version=*)
            ASPSX_VERSION="$(option_value "$1" "--aspsx-version=")"
            shift
            ;;
        -o)
            arg_required "$1" "${2-}"
            OUTPUT="$2"
            shift 2
            ;;
        -c)
            if [ "$MODE" = "preprocess" ]; then
                die "-c cannot be combined with -E"
            fi
            MODE="compile"
            _COMPILE_REQUESTED=1
            shift
            ;;
        -E)
            if [ "$_COMPILE_REQUESTED" = "1" ]; then
                die "-E cannot be combined with -c"
            fi
            MODE="preprocess"
            PREPROCESS_FLAGS="$PREPROCESS_FLAGS $1"
            shift
            ;;
        -P|-dD)
            PREPROCESS_FLAGS="$PREPROCESS_FLAGS $1"
            shift
            ;;
        -I)
            arg_required "$1" "${2-}"
            EXTRA_INC_FLAGS="$EXTRA_INC_FLAGS -I$2"
            shift 2
            ;;
        -I*)
            EXTRA_INC_FLAGS="$EXTRA_INC_FLAGS $1"
            shift
            ;;
        -D)
            arg_required "$1" "${2-}"
            EXTRA_FLAGS="$EXTRA_FLAGS -D$2"
            shift 2
            ;;
        -D*)
            EXTRA_FLAGS="$EXTRA_FLAGS $1"
            shift
            ;;
        -*)
            EXTRA_FLAGS="$EXTRA_FLAGS $1"
            shift
            ;;
        *)
            if [ -n "$SOURCE" ]; then
                die "multiple source files: $SOURCE and $1"
            fi
            SOURCE="$1"
            shift
            ;;
    esac
done

# --- profile resolution ---

if [ "$PROFILE" != "$MASPSX_DEFAULT_PROFILE" ]; then
    # If it looks like a path (contains / or ends with .toml), use as-is.
    # Otherwise look it up as a profile name under config/compiler/.
    case "$PROFILE" in
        */*|*.toml)
            # already a path
            ;;
        *)
            PROFILE="${REBOF3_ROOT_DIR}/config/compiler/${PROFILE}.toml"
            ;;
    esac
fi

if [ ! -f "$PROFILE" ]; then
    die "profile not found: $PROFILE"
fi

# --- validate ---

if [ -z "$SOURCE" ] || [ -z "$OUTPUT" ]; then
    echo "$MASPSX_USAGE" >&2
    exit 1
fi

if [ ! -f "$SOURCE" ]; then
    die "source file not found: $SOURCE"
fi

# --- load profile ---

MASPSX_PYTHON="${REBOF3_ROOT_DIR}/.venv/bin/python"
if [ ! -x "$MASPSX_PYTHON" ]; then
    die "Python venv not found at $MASPSX_PYTHON (run 'just venv')"
fi

eval "$("$MASPSX_PYTHON" "$MASPSX_PROFILE_BIN" --root "$REBOF3_ROOT_DIR" "$PROFILE")"

# --- resolve tools ---

GCC="$(resolve_tool "gcc" "$CC_PATH")"
GCC_DIR="$(dirname "$GCC")"
AS_BIN="${AS_TOOLCHAIN_BIN}/${AS_NAME}"
AS="$(resolve_tool "as" "$AS_BIN")"

if [ -z "$PSYQ_ROOT" ]; then
    PSYQ_ROOT="${REBOF3_ROOT_DIR}/toolchains/psyq/${PSYQ_VERSION}"
fi
PSYQ_INCLUDE="${PSYQ_ROOT}/include"
if [ ! -d "$PSYQ_INCLUDE" ]; then
    die "missing PsyQ include root: $PSYQ_INCLUDE"
fi

if [ -z "$ASPSX_VERSION" ]; then
    ASPSX_VERSION="${ASPSX_VERSION_DEFAULT:-2.56}"
fi

# --- tool environment ---

export PATH="${GCC_DIR}:${AS_TOOLCHAIN_BIN}:${PATH}"
export GCC_EXEC_PREFIX="${GCC_DIR}/"
export COMPILER_PATH="${GCC_DIR}"

# --- dispatch ---

if [ "$MODE" = "preprocess" ]; then
    # shellcheck disable=SC2086
    "$GCC" -I"$PSYQ_INCLUDE" $EXTRA_INC_FLAGS $CC_PROFILE_FLAGS $EXTRA_FLAGS \
        $PREPROCESS_FLAGS -o "$OUTPUT" "$SOURCE"
    exit 0
fi

case "$SOURCE" in
    *.s|*.S)
        # shellcheck disable=SC2086
        "$AS" $AS_FLAGS -o "$OUTPUT" "$SOURCE"
        exit 0
        ;;
esac

# --- compile C ---

ASM_FILE="${OUTPUT}.s"

# shellcheck disable=SC2086
"$GCC" -I"$PSYQ_INCLUDE" $EXTRA_INC_FLAGS $CC_PROFILE_FLAGS $EXTRA_FLAGS \
    -S -o "$ASM_FILE" "$SOURCE" || die "gcc compile failed"

# !pipefail equivalent for POSIX sh
if ! "$MASPSX_PYTHON" "$MASPSX_SCRIPT" --aspsx-version="$ASPSX_VERSION" "$ASM_FILE" | \
    "$AS" $AS_FLAGS -o "$OUTPUT" - ; then
    die "maspsx translation or assembly failed"
fi
