#!/bin/sh
set -eu

REBOF3_SCRIPT_DIR="$(CDPATH= cd -- "$(dirname "$0")" && pwd)"
REBOF3_PYTHON_ENTRY="${REBOF3_SCRIPT_DIR}/_python_entry"
REBOF3_ENTRY_MODULE="rebof3.commands.toolchain"
REBOF3_ENTRY_ARG_1="psyq"
REBOF3_ENTRY_ARG_2="import"
REBOF3_HELP_USAGE="usage: download-psyq [--version VERSION] [--archive PATH] [--archive-url URL] [--dest PATH] [--private-root PATH] [--force]"
REBOF3_HELP_DESCRIPTION="Download, cache, extract, and stage a PsyQ SDK archive."

if [ "${1-}" = "-h" ] || [ "${1-}" = "--help" ]; then
  printf '%s\n' "${REBOF3_HELP_USAGE}"
  printf '%s\n' ''
  printf '%s\n' "${REBOF3_HELP_DESCRIPTION}"
  exit 0
fi

exec "${REBOF3_PYTHON_ENTRY}" "${REBOF3_ENTRY_MODULE}" "${REBOF3_ENTRY_ARG_1}" "${REBOF3_ENTRY_ARG_2}" "$@"
